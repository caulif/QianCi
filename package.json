{
  "name": "qianci",
  "version": "0.2.0",
  "private": true,
  "description": "A minimal browser extension for predictive English word lookup while reading.",
  "license": "MIT",
  "author": "caulif",
  "repository": {
    "type": "git",
    "url": "https://github.com/caulif/QianCi.git"
  },
  "bugs": {
    "url": "https://github.com/caulif/QianCi/issues"
  },
  "homepage": "https://github.com/caulif/QianCi#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build:data",
    "build": "vite build",
    "build:data": "tsx scripts/build-dictionary.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test:unit": "vitest run",
    "test:e2e": "tsx scripts/smoke-extension.ts",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
